{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/check-explore-path.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "cd \"/c/Project/DeepInsight\" && npm run build >/dev/null 2>&1 || echo '{\"systemMessage\":\"⚠ dashboard build 失败，手动跑 npm run build 看错误\"}'",
            "timeout": 30,
            "statusMessage": "重建 dashboard"
          }
        ]
      }
    ]
  }
}
